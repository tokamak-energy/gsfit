<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for configuration.xml: the shape of the LCFS, a model surface or given points.

    References are to L. Guazzotto and J. P. Freidberg, J. Plasma Phys. 87 (2021) 905870303.
    See ../BUXTON_PROKOPYSZYN_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ===================================== Enums ===================================== -->

    <xs:simpleType name="ConfigurationMethod">
        <xs:annotation>
            <xs:documentation>
                The shapes of the LCFS.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="symmetric_limited">
                <xs:annotation>
                    <xs:documentation>
                        Up-down symmetric limited plasma: Guazzotto and Freidberg's Miller surface (Sec. 3).
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="double_null">
                <xs:annotation>
                    <xs:documentation>
                        Up-down symmetric double null: two ellipses meeting at right angles at each X-point (Sec. 4).
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="single_null">
                <xs:annotation>
                    <xs:documentation>
                        Lower single null: a Miller upper half and, below z_geo, the double null's two ellipses meeting at the X-point (Sec. 5).
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="antisymmetric_limited">
                <xs:annotation>
                    <xs:documentation>
                        Up-down asymmetric limited plasma: Miller upper and lower halves, each with its own elongation and triangularity.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="lcfs_points">
                <xs:annotation>
                    <xs:documentation>
                        Given points on the LCFS, with or without an X-point, e.g. from a reconstruction.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed, and nor is a number beyond the largest double, e.g. `1e400`, which would be read as infinite.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
            <xs:minInclusive value="-1.7976931348623157e308"/>
            <xs:maxInclusive value="1.7976931348623157e308"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FinitePositiveDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteNonNegativeDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than or equal to 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Triangularity">
        <xs:annotation>
            <xs:documentation>
                A triangularity: a finite number greater than -1 and less than 1.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minExclusive value="-1.0"/>
            <xs:maxExclusive value="1.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteDoubleList">
        <xs:annotation>
            <xs:documentation>
                A list of finite numbers, written space-separated, e.g. "0.1 0.2 0.3".
            </xs:documentation>
        </xs:annotation>
        <xs:list itemType="FiniteDouble"/>
    </xs:simpleType>

    <xs:simpleType name="FinitePositiveDoubleList">
        <xs:annotation>
            <xs:documentation>
                A list of finite numbers greater than 0, written space-separated, e.g. "0.1 0.2 0.3".
            </xs:documentation>
        </xs:annotation>
        <xs:list itemType="FinitePositiveDouble"/>
    </xs:simpleType>

    <xs:simpleType name="TrueOrFalse">
        <xs:annotation>
            <xs:documentation>
                A boolean written as `true` or `false`; `xs:boolean` alone would also accept `1` and `0`.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:boolean">
            <xs:pattern value="true|false"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="SymmetricLimited">
        <xs:annotation>
            <xs:documentation>
                Settings for the up-down symmetric limited plasma.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="r_geo" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Major radius midway between the innermost and outermost points of the LCFS.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="z_geo" type="FiniteDouble">
                <xs:annotation>
                    <xs:documentation>
                        Height of the innermost and outermost points, about which the series is built.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="a_minor" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Minor radius, half the distance between the innermost and outermost points; less than r_geo.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="kappa" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Elongation: the height of the top above z_geo, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="delta" type="Triangularity">
                <xs:annotation>
                    <xs:documentation>
                        Triangularity: r_geo minus the major radius of the top, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="DoubleNull">
        <xs:annotation>
            <xs:documentation>
                Settings for the up-down symmetric double null.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="r_geo" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Major radius midway between the innermost and outermost points of the LCFS.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="z_geo" type="FiniteDouble">
                <xs:annotation>
                    <xs:documentation>
                        Height of the innermost and outermost points, about which the series is built.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="a_minor" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Minor radius, half the distance between the innermost and outermost points; less than r_geo.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="kappa_x" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Elongation at the X-points: their height above and below z_geo, over a_minor; more than 2 (1 - delta_x**2)**0.5.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="delta_x" type="Triangularity">
                <xs:annotation>
                    <xs:documentation>
                        Triangularity at the X-points: r_geo minus their major radius, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="SingleNull">
        <xs:annotation>
            <xs:documentation>
                Settings for the lower single null.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="r_geo" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Major radius midway between the innermost and outermost points of the LCFS.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="z_geo" type="FiniteDouble">
                <xs:annotation>
                    <xs:documentation>
                        Height of the innermost and outermost points, about which the series is built.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="a_minor" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Minor radius, half the distance between the innermost and outermost points; less than r_geo.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="kappa" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Elongation of the upper half: the height of the top above z_geo, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="delta" type="Triangularity">
                <xs:annotation>
                    <xs:documentation>
                        Triangularity of the upper half: r_geo minus the major radius of the top, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="kappa_x" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Elongation at the X-point: its depth below z_geo, over a_minor; more than 2 (1 - delta_x**2)**0.5.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="delta_x" type="Triangularity">
                <xs:annotation>
                    <xs:documentation>
                        Triangularity at the X-point: r_geo minus its major radius, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="AntisymmetricLimited">
        <xs:annotation>
            <xs:documentation>
                Settings for the up-down asymmetric limited plasma.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="r_geo" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Major radius midway between the innermost and outermost points of the LCFS.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="z_geo" type="FiniteDouble">
                <xs:annotation>
                    <xs:documentation>
                        Height of the innermost and outermost points, about which the series is built.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="a_minor" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Minor radius, half the distance between the innermost and outermost points; less than r_geo.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="kappa_upper" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Elongation of the upper half: the height of the top above z_geo, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="delta_upper" type="Triangularity">
                <xs:annotation>
                    <xs:documentation>
                        Triangularity of the upper half: r_geo minus the major radius of the top, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="kappa_lower" type="FinitePositiveDouble">
                <xs:annotation>
                    <xs:documentation>
                        Elongation of the lower half: the depth of the bottom below z_geo, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="delta_lower" type="Triangularity">
                <xs:annotation>
                    <xs:documentation>
                        Triangularity of the lower half: r_geo minus the major radius of the bottom, over a_minor.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="LcfsPoints">
        <xs:annotation>
            <xs:documentation>
                Settings for given LCFS points. Each point gives psi = 0, and the X-point psi = psi_R = psi_Z = 0. r_geo and z_geo are the middle of the radial and vertical extent of the points and the X-point, and a_minor is half the radial extent. Use about 7 + 10 (n_wave - 1 + n_wave_cosh) points or more on each half, spread over the whole LCFS, even an up-down symmetric one.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="boundary_r" type="FinitePositiveDoubleList">
                <xs:annotation>
                    <xs:documentation>
                        Major radius of each point; at least one.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="boundary_z" type="FiniteDoubleList">
                <xs:annotation>
                    <xs:documentation>
                        Height of each point, as many as boundary_r.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="x_point_r" type="FinitePositiveDouble" nillable="true">
                <xs:annotation>
                    <xs:documentation>
                        Major radius of the X-point; nil, with x_point_z, for none.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="x_point_z" type="FiniteDouble" nillable="true">
                <xs:annotation>
                    <xs:documentation>
                        Height of the X-point; nil, with x_point_r, for none.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="x_point_weight" type="FiniteNonNegativeDouble">
                <xs:annotation>
                    <xs:documentation>
                        Weight of the X-point's conditions relative to each point's, when they are fitted by least squares (exact_x_points false in numerics.xml).
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="is_up_down_symmetric" type="TrueOrFalse">
                <xs:annotation>
                    <xs:documentation>
                        Whether the flux is even in Z - z_geo: the points are reflected onto the upper half and the X-point is mirrored. When false, the flux has odd terms too, and n_wave_cosh must be 0.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="configuration">
        <xs:annotation>
            <xs:documentation>
                The shape of the LCFS. A model surface is centred on (r_geo, z_geo), its innermost and outermost points being at r_geo - a_minor and r_geo + a_minor.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="method" type="ConfigurationMethod">
                    <xs:annotation>
                        <xs:documentation>
                            The shape to use. Its settings are in the element of the same name, below.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="symmetric_limited" type="SymmetricLimited" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Settings for the up-down symmetric limited plasma.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="double_null" type="DoubleNull" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Settings for the up-down symmetric double null.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="single_null" type="SingleNull" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Settings for the lower single null.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="antisymmetric_limited" type="AntisymmetricLimited" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Settings for the up-down asymmetric limited plasma.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="lcfs_points" type="LcfsPoints" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Settings for given LCFS points.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
