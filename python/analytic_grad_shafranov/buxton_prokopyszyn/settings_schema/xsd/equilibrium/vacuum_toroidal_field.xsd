<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for vacuum_toroidal_field.xml: the vacuum toroidal field, b0 at the major radius r0, written to the Equilibrium IDS's
    vacuum_toroidal_field/r0 and vacuum_toroidal_field/b0.

    See ../BUXTON_PROKOPYSZYN_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed, and nor is a number beyond the largest double, e.g. `1e400`, which would be read as infinite.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
            <xs:minInclusive value="-1.7976931348623157e308"/>
            <xs:maxInclusive value="1.7976931348623157e308"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FinitePositiveDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="vacuum_toroidal_field">
        <xs:annotation>
            <xs:documentation>
                The vacuum toroidal field, b0 at the major radius r0. Their product is f = R B_phi on the LCFS.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="r0" type="FinitePositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Major radius at which b0 is given, e.g. the machine's reference radius.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="b0" type="FiniteDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Vacuum toroidal field at r0; non-zero. f has its sign.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>tesla</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
