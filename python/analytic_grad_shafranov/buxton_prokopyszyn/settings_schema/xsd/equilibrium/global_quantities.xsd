<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for global_quantities.xml: the plasma current, which the Equilibrium IDS's global_quantities/ip is then.

    See ../BUXTON_PROKOPYSZYN_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed, and nor is a number beyond the largest double, e.g. `1e400`, which would be read as infinite.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
            <xs:minInclusive value="-1.7976931348623157e308"/>
            <xs:maxInclusive value="1.7976931348623157e308"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="global_quantities">
        <xs:annotation>
            <xs:documentation>
                Global quantities the equilibrium is made to have.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="ip" type="FiniteDouble" nillable="true">
                    <xs:annotation>
                        <xs:documentation>
                            Plasma current: both coefficient lists in profiles.xml are multiplied by the one factor that gives it, which leaves the flux surfaces unchanged; nil for the coefficients as given. Non-zero.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>ampere</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
