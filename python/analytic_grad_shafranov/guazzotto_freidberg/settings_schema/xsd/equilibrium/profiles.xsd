<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for profiles.xml: Guazzotto and Freidberg's profile parameter, nu, and pressure normalisation, p_0, which give p' and ff'.

    The pressure is p = p_0 psi_hat**2, with Guazzotto and Freidberg's normalised flux psi_hat = psi / psi_0, which is 0 on the boundary and
    1 at R = R_c, Z = z_geo, with R_c**2 = r_geo**2 + a_minor**2. p' and ff' are both proportional to psi, with ff' = mu0 R_c**2 p' (1 - nu) / nu.
    References are to L. Guazzotto and J. P. Freidberg, J. Plasma Phys. 87 (2021) 905870303.
    See ../GUAZZOTTO_FREIDBERG_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed, and nor is a number beyond the largest double, e.g. `1e400`, which would be read as infinite.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
            <xs:minInclusive value="-1.7976931348623157e308"/>
            <xs:maxInclusive value="1.7976931348623157e308"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FinitePositiveDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="profiles">
        <xs:annotation>
            <xs:documentation>
                Guazzotto and Freidberg's profiles: p' and ff' are both proportional to psi, so both are proportional to 1 - psi_N, with psi_N 0 on the magnetic axis and 1 on the boundary.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="nu" type="FinitePositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Guazzotto and Freidberg's profile parameter, roughly the poloidal beta: ff' = mu0 R_c**2 p' (1 - nu) / nu, so 1 for no ff', below 1 for a paramagnetic plasma and above 1 for a diamagnetic one.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>dimensionless</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="p_0" type="FinitePositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Guazzotto and Freidberg's p_0: the pressure where psi_hat = 1, at R = R_c, Z = z_geo. The magnetic axis is close to it, with psi_hat a little above 1. It sets the size of p', ff' and the plasma current, with beta_0 = 2 mu0 p_0 / B_0**2 (Eq. 6.4).
                        </xs:documentation>
                        <xs:appinfo>
                            <units>pascal</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
