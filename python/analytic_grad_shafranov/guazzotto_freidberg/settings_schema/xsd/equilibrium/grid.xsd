<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for grid.xml: the (R, Z) grid the Equilibrium IDS is filled on, with the PF coils on its boundary, and the psi_norm grid for its 1D profiles.

    The elements are GSFit's (python/gsfit/settings_schema/xsd/equilibrium/grid.xsd), with the analytic solution's minimum numbers of points.
    See ../GUAZZOTTO_FREIDBERG_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="NumberOfGridPoints">
        <xs:annotation>
            <xs:documentation>
                A number of equally spaced (R, Z) grid points along one direction: at least 4.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="4"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NumberOfPsiNormPoints">
        <xs:annotation>
            <xs:documentation>
                A number of equally spaced psi_norm points: at least 3.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="3"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed, and nor is a number beyond the largest double, e.g. `1e400`, which would be read as infinite.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
            <xs:minInclusive value="-1.7976931348623157e308"/>
            <xs:maxInclusive value="1.7976931348623157e308"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FinitePositiveDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="grid">
        <xs:annotation>
            <xs:documentation>
                The (R, Z) grid the Equilibrium IDS is filled on, and the psi_norm grid for its 1D profiles. It must contain the model surface. `GuazzottoFreidberg.get_pf_active` puts one PF coil on each point of its boundary, and the Equilibrium IDS holds the flux of the plasma and the coils, which is a vacuum field outside the plasma.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="n_r" type="NumberOfGridPoints">
                    <xs:annotation>
                        <xs:documentation>
                            Number of radial grid points.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="n_z" type="NumberOfGridPoints">
                    <xs:annotation>
                        <xs:documentation>
                            Number of vertical grid points.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="r_min" type="FinitePositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Lower radial bound of the grid; at most r_geo - a_minor.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="r_max" type="FinitePositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Upper radial bound of the grid; at least r_geo + a_minor.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="z_min" type="FiniteDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Lower vertical bound of the grid; at most the bottom of the model surface.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="z_max" type="FiniteDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Upper vertical bound of the grid; at least the top of the model surface.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="n_psi_norm" type="NumberOfPsiNormPoints">
                    <xs:annotation>
                        <xs:documentation>
                            Number of points in the normalised poloidal flux, `psi_norm` from 0.0 to 1.0.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
