<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for workflow.xml: the central list of the codes which the database reader reads from, and which run of each to read.

    Each code is an MDSplus tree, e.g. ELMAG, which holds the machine's geometry, or MAG, which holds the magnetic sensors.
    workflow.xml has one optional element per code, named after it in lower case, e.g. `elmag`, saying which run to read, and from which pulse.
    The IDS files which the database reader builds from these codes link to workflow.xml, in `workflow`, e.g. `<workflow href="../workflow.xml"/>`
    in pf_active/pf_active.xml. So a code's run is set once, however many IDSs are built from it: ELMAG builds pf_active, pf_passive,
    pulse_schedule and wall. The reader reads the codes it needs from the workflow.xml which the IDS's file links to, and stops with an
    error if one is missing.
    The Tokamak Energy writers store every code with the results, in INPUT.WORKFLOW, to record where the inputs came from.
    So far only the st40_mdsplus_with_digital_filter reader reads workflow.xml. The other readers still read their runs from their own
    element in each IDS's file.
    WorkflowEntry is the same as in each IDS's schema, so change them all together.
    See GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="WorkflowEntry">
        <xs:annotation><xs:documentation>Which run of an MDSplus tree to read. The tree is named by the element holding this, e.g. `elmag` for ELMAG</xs:documentation></xs:annotation>
        <xs:all>
            <xs:element name="pulseNo" type="xs:int" nillable="true">
                <xs:annotation><xs:documentation>The pulse to read the tree from; nil for the pulse being reconstructed</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="run_name" type="xs:string">
                <xs:annotation><xs:documentation>The run of the tree to read, e.g. "BEST" or "RUN16"</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="usage" type="xs:string">
                <xs:annotation><xs:documentation>What the tree's data is used for. Free text, which the Tokamak Energy writers store with the results (INPUT.WORKFLOW.[tree].USAGE), to record where the inputs came from</xs:documentation></xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="workflow">
        <xs:annotation><xs:documentation>The central list of the codes which the database reader reads from, and which run of each to read. Each IDS's file links to it, in `workflow`, e.g. pf_active/pf_active.xml</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="dialoop" type="WorkflowEntry" minOccurs="0">
                    <xs:annotation><xs:documentation>The DIALOOP run holding the diamagnetic flux measurement, GLOBAL.PHI_DIA. Read for magnetics</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="elmag" type="WorkflowEntry" minOccurs="0">
                    <xs:annotation><xs:documentation>The ELMAG run holding the machine's geometry: the PF coils, COILS; the passive structures and their resistivity, VESSEL; the limiter, LIMITER.LIMIT_PTS; and the gaps, GAPS. Read for pf_active, pf_passive, pulse_schedule and wall</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="mag" type="WorkflowEntry" minOccurs="0">
                    <xs:annotation><xs:documentation>The MAG run holding the geometry and measurements of the poloidal field probes, flux loops and Rogowski coils, and the geometry of the diamagnetic loop. Read for magnetics</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="ppts" type="WorkflowEntry" minOccurs="0">
                    <xs:annotation><xs:documentation>The PPTS run whose BAD_MA flag, GLOBAL:BAD_MA, picks the good time-slices: those the pressure constraints are made at, and the good_pressure_sensors time-slices in timeslices.xml. Read for thomson_scattering</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="psu2coil" type="WorkflowEntry" minOccurs="0">
                    <xs:annotation><xs:documentation>The PSU2COIL run holding the currents: the PF coils', PF.ALL, and the TF rod's, TF.I_ROD. Read for pf_active and tf</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="ts" type="WorkflowEntry" minOccurs="0">
                    <xs:annotation><xs:documentation>The TS run holding each channel's position, R and Z, and electron pressure, PROFILES:PE. Read for thomson_scattering</xs:documentation></xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
