<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for constraints_rogowski_coil.xml: how each Rogowski coil is fitted.

    Named as in the IMAS Data Dictionary: magnetics rogowski_coil[:]. The equilibrium IDS has no
    Rogowski coil constraint; GSFit's IMAS writer puts them in time_slice[:]/constraints/pf_passive_current[:].
    The root element is `constraints__rogowski_coil`, the path of this file's link in
    equilibrium.xml with `__` for `/`, and each `rogowski_coil` element has the type
    `rogowski_coil`. Neither these names nor the Python classes generated from them then clash with
    those of the other constraints files.

    constraints_flux_loop.xsd, constraints_rogowski_coil.xsd, constraints_diamagnetic_flux.xsd and
    constraints_isoflux.xsd are the same apart from their names, documentation, units and number of
    elements, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= The settings file ================================= -->

    <xs:element name="constraints__rogowski_coil">
        <xs:annotation>
            <xs:documentation>
                How each Rogowski coil is fitted, one `rogowski_coil` per coil. A coil the database has but this file does not list is not fitted, and a listed coil the database does not have is ignored. Not read by the freegs reader
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="rogowski_coil" type="rogowski_coil" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>
                            One Rogowski coil, which measures the current through it: the plasma current and the currents in the structures it encloses
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
        <xs:unique name="constraints_rogowski_coil_unique_name">
            <xs:annotation>
                <xs:documentation>
                    Each rogowski_coil is listed at most once
                </xs:documentation>
            </xs:annotation>
            <xs:selector xpath="rogowski_coil"/>
            <xs:field xpath="name"/>
        </xs:unique>
    </xs:element>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="Name">
        <xs:annotation>
            <xs:documentation>
                A name, with no spaces
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NonNegativeDouble">
        <xs:annotation>
            <xs:documentation>
                A number greater than or equal to 0
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="rogowski_coil">
        <xs:annotation>
            <xs:documentation>
                One Rogowski coil, which measures the current through it: the plasma current and the currents in the structures it encloses
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="name" type="Name">
                <xs:annotation>
                    <xs:documentation>
                        The coil's name in the database, e.g. "INIVC000" or "BVLT"
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="expected_value" type="xs:double">
                <xs:annotation>
                    <xs:documentation>
                        The typical size of the coil's measurement. The fit divides the residual by it
                    </xs:documentation>
                    <xs:appinfo>
                        <units>A</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="weight" type="NonNegativeDouble">
                <xs:annotation>
                    <xs:documentation>
                        Relative weight of the constraint in the fit. Its least-squares weight is weight / expected_value
                    </xs:documentation>
                    <xs:appinfo>
                        <units>1</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Whether the constraint is fitted
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="comment" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Free text, e.g. why the constraint is not included; not used by the fit
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>
</xs:schema>
