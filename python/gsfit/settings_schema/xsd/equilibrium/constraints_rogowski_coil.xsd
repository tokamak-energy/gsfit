<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for constraints_rogowski_coil.xml: how each Rogowski coil is fitted.

    Named as in the IMAS Data Dictionary: magnetics rogowski_coil[:]. The Data Dictionary's equilibrium IDS
    has no Rogowski coil constraint, so GSFit adds its own, time_slice[:]/constraints/rogowski_coil[:];
    GSFit's IMAS writer puts them in time_slice[:]/constraints/pf_passive_current[:].
    The root element is `constraints__rogowski_coil`, the path of this file's link in
    equilibrium.xml with `__` for `/`, and each `rogowski_coil` element has the type
    `RogowskiCoil`. Neither these names nor the Python classes generated from them then clash with
    those of the other constraints files.

    constraints_flux_loop.xsd, constraints_rogowski_coil.xsd, constraints_diamagnetic_flux.xsd and
    constraints_isoflux.xsd are the same apart from their names, documentation, units and number of
    elements, and the diamagnetic flux having no `name`, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= The settings file ================================= -->

    <xs:element name="constraints__rogowski_coil">
        <xs:annotation>
            <xs:documentation>
                Fitting settings for the Rogowski coils, with one `rogowski_coil` element per Rogowski coil.
                A Rogowski coil measures the current through it: the plasma current and the currents in the structures it encloses.
                A Rogowski coil read by the `database_reader` which is not listed here is not included in the fit.
                Not read by the freegs reader.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="rogowski_coil" type="RogowskiCoil" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>
                            Fitting settings for one Rogowski coil.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
        <xs:key name="rogowski_coil_name_key">
            <xs:annotation>
                <xs:documentation>
                    Each Rogowski coil's `name` must be unique.
                </xs:documentation>
            </xs:annotation>
            <xs:selector xpath="rogowski_coil"/>
            <xs:field xpath="name"/>
        </xs:key>
    </xs:element>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="Name">
        <xs:annotation>
            <xs:documentation>
                A non-empty name without any whitespace.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteNonNegativeDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than or equal to 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TrueOrFalse">
        <xs:annotation>
            <xs:documentation>
                A boolean written as `true` or `false`; `xs:boolean` alone would also accept `1` and `0`.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:boolean">
            <xs:pattern value="true|false"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="RogowskiCoil">
        <xs:annotation>
            <xs:documentation>
                Fitting settings for one Rogowski coil.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="name" type="Name">
                <xs:annotation>
                    <xs:documentation>
                        Name of the Rogowski coil, e.g. `INIVC000` or `BVLT`.
                        Must be unique, and must match the name of a Rogowski coil stored in `rogowski_coil(i1)/name`.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="expected_value" type="FiniteDouble">
                <xs:annotation>
                    <xs:documentation>
                        Expected magnitude of the measurement, used to normalise the measurement.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>ampere</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="weight" type="FiniteNonNegativeDouble">
                <xs:annotation>
                    <xs:documentation>
                        Relative weight of the Rogowski coil in the least-squares fit.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="TrueOrFalse">
                <xs:annotation>
                    <xs:documentation>
                        Whether to include the Rogowski coil in the fit.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="comment" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Free-text comment, e.g. on the quality of the signal; may be empty.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>
</xs:schema>
