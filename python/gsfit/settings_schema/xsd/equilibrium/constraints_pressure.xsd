<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for constraints_pressure.xml: whether pressure is fitted, and how the pressure constraints are made.

    Named as in the IMAS Data Dictionary: equilibrium time_slice[:]/constraints/pressure[:]. There it is
    an array, one element per measurement. Here it is a single element, which says how
    Equilibrium.copy_from_core_profiles_ids makes that array from the core_profiles IDS: one constraint per point of
    core_profiles/profiles_2d(itime), all fitted the same way. How core_profiles is made from the measurements is in
    core_profiles/core_profiles.xml.
    The root element is `constraints__pressure`, the path of this file's link in equilibrium.xml
    with `__` for `/`. Neither it nor the Python class generated from it then clashes with those of the
    other constraints files.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= The settings file ================================= -->

    <xs:element name="constraints__pressure">
        <xs:annotation>
            <xs:documentation>
                Whether pressure is fitted, and how the pressure constraints are made from the core_profiles IDS, by Equilibrium.copy_from_core_profiles_ids.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="pressure" type="Pressure">
                    <xs:annotation>
                        <xs:documentation>
                            Whether pressure is fitted, and how the pressure constraints are made.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="Name">
        <xs:annotation>
            <xs:documentation>
                A non-empty name without any whitespace.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed, and nor is a number beyond the largest double, e.g. `1e400`, which would be read as infinite.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
            <xs:minInclusive value="-1.7976931348623157e308"/>
            <xs:maxInclusive value="1.7976931348623157e308"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteNonNegativeDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than or equal to 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TrueOrFalse">
        <xs:annotation>
            <xs:documentation>
                A boolean written as `true` or `false`; `xs:boolean` alone would also accept `1` and `0`.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:boolean">
            <xs:pattern value="true|false"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="Synthetic">
        <xs:annotation>
            <xs:documentation>
                Synthetic pressure constraints, from the pressure profile of the FreeGSNKE equilibria, along the midplane outboard of the magnetic axis. Read by the freegsnke reader.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="r_start" type="FiniteDouble">
                <xs:annotation>
                    <xs:documentation>
                        Major radius of the first sensor, relative to the magnetic axis.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="r_end" type="FiniteDouble">
                <xs:annotation>
                    <xs:documentation>
                        Major radius of the last sensor, relative to the magnetic axis.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>metre</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="n_sensors" type="xs:nonNegativeInteger">
                <xs:annotation>
                    <xs:documentation>
                        Number of sensors, evenly spaced from r_start to r_end.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="minimum_pressure" type="FiniteNonNegativeDouble">
                <xs:annotation>
                    <xs:documentation>
                        Pressures at or below this are ignored, e.g. those of sensors outside the plasma. A sensor with none above it gets no constraint.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>pascal</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="Pressure">
        <xs:annotation>
            <xs:documentation>
                Whether pressure is fitted, and how the pressure constraints are made.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="include" type="TrueOrFalse">
                <xs:annotation>
                    <xs:documentation>
                        Whether to fit pressure. When false, nothing else in this file is read.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sensor_name_prefix" type="Name" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        The pressure constraints are named this followed by the two-digit number of the point of core_profiles/profiles_2d(itime) they were measured at, from 1, e.g. PRESSURE01. Needed when `include` is true.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="expected_value" type="FiniteDouble" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        The typical size of the measured pressure. The fit divides the residual by it. Needed when `include` is true.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>pascal</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="weight" type="FiniteNonNegativeDouble" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Relative weight of each pressure constraint in the fit. Its least-squares weight is weight / expected_value. Needed when `include` is true.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="comment" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Free text, about the pressure constraints; not used by the fit. Needed when `include` is true.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="synthetic" type="Synthetic" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Synthetic pressure constraints from the FreeGSNKE equilibria. Needed by the freegsnke reader when `include` is true.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>
</xs:schema>
