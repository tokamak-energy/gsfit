<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for pf_passive_dof.xml: the degrees of freedom of the currents in the passive
    structures, and their regularisation. One `passive` per passive structure, named as in the database.

    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ===================================== Enums ===================================== -->

    <xs:simpleType name="CurrentDistributionType">
        <xs:annotation>
            <xs:documentation>
                How the current is distributed over a passive's filaments, from `PfPassive::add_loop`
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="constant_current_density">
                <xs:annotation>
                    <xs:documentation>
                        The same current density in every filament: one degree of freedom
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="eig">
                <xs:annotation>
                    <xs:documentation>
                        A sum of eigenmodes of the passive's mutual inductance and resistance: n_dof degrees of freedom
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="Name">
        <xs:annotation>
            <xs:documentation>
                A non-empty name without any whitespace.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteNonNegativeDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than or equal to 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteDoubleList">
        <xs:annotation>
            <xs:documentation>
                A list of finite numbers, written space-separated, e.g. "0.1 0.2 0.3".
            </xs:documentation>
        </xs:annotation>
        <xs:list itemType="FiniteDouble"/>
    </xs:simpleType>

    <xs:simpleType name="FiniteNonNegativeDoubleList">
        <xs:annotation>
            <xs:documentation>
                A list of finite numbers greater than or equal to 0, written space-separated, e.g. "0.1 0.2 0.3".
            </xs:documentation>
        </xs:annotation>
        <xs:list itemType="FiniteNonNegativeDouble"/>
    </xs:simpleType>

    <xs:simpleType name="TrueOrFalse">
        <xs:annotation>
            <xs:documentation>
                A boolean written as `true` or `false`; `xs:boolean` alone would also accept `1` and `0`.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:boolean">
            <xs:pattern value="true|false"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="Regularisations">
        <xs:annotation>
            <xs:documentation>
                A matrix of shape [n_regularisations, n_dof], one `row` per regularisation. Each row is a combination of the degrees of freedom which the fit drives towards zero. No rows for no regularisation
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="row" type="FiniteDoubleList" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        One regularisation: a coefficient for each degree of freedom, as a space-separated list
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Passive">
        <xs:annotation>
            <xs:documentation>
                The degrees of freedom of one passive structure's current, and their regularisation
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="name" type="Name">
                <xs:annotation>
                    <xs:documentation>
                        The passive's name in the database, e.g. "IVC"
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="current_distribution_type" type="CurrentDistributionType">
                <xs:annotation>
                    <xs:documentation>
                        How the current is distributed over the passive's filaments. Not read at present: the readers set it in the code
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="TrueOrFalse">
                <xs:annotation>
                    <xs:documentation>
                        Whether the passive is included. Not read at present
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="n_dof" type="xs:positiveInteger">
                <xs:annotation>
                    <xs:documentation>
                        Number of degrees of freedom of the passive's current: 1 for constant_current_density, the number of eigenmodes for eig
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="regularisations" type="Regularisations">
                <xs:annotation>
                    <xs:documentation>
                        The regularisations, one `row` of n_dof coefficients each; no rows for none
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="regularisations_weight" type="FiniteNonNegativeDoubleList">
                <xs:annotation>
                    <xs:documentation>
                        The weight of each regularisation in the fit: one per `row` of `regularisations`
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="pf_passive_dof">
        <xs:annotation>
            <xs:documentation>
                The degrees of freedom of the currents in the passive structures, and their regularisation, one `passive` per structure. At present only the IVC's n_dof, regularisations and regularisations_weight are read, by the ST40 readers (and its n_dof by the rtgsfit_mdsplus writer); everything else is set in the code. The FreeGS and FreeGSNKE readers read none of it
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="passive" type="Passive" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>
                            One passive structure
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
        <xs:unique name="pf_passive_dof_unique_name">
            <xs:annotation>
                <xs:documentation>
                    Each passive is listed at most once
                </xs:documentation>
            </xs:annotation>
            <xs:selector xpath="passive"/>
            <xs:field xpath="name"/>
        </xs:unique>
    </xs:element>
</xs:schema>
