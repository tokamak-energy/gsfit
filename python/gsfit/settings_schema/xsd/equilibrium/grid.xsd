<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for grid.xml: the (R, Z) grid the equilibrium is solved on, and the psi_norm grid of the 1D profiles.

    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="NumberOfGridPoints">
        <xs:annotation>
            <xs:documentation>
                A number of evenly spaced grid points: at least 2, so that they have a spacing.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FinitePositiveDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="grid">
        <xs:annotation>
            <xs:documentation>
                The (R, Z) grid the equilibrium is solved on, and the psi_norm grid of the 1D profiles
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="n_r" type="NumberOfGridPoints">
                    <xs:annotation>
                        <xs:documentation>
                            Number of radial grid points
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="n_z" type="NumberOfGridPoints">
                    <xs:annotation>
                        <xs:documentation>
                            Number of vertical grid points
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="r_min" type="FinitePositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Lower radial bound of the grid
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="r_max" type="FinitePositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Upper radial bound of the grid
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="z_min" type="FiniteDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Lower vertical bound of the grid
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="z_max" type="FiniteDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Upper vertical bound of the grid
                        </xs:documentation>
                        <xs:appinfo>
                            <units>metre</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="n_psi_norm" type="NumberOfGridPoints">
                    <xs:annotation>
                        <xs:documentation>
                            Number of points in the normalised poloidal flux, `psi_norm`, evenly spaced from 0 (magnetic axis) to 1 (boundary), on which the 1D profiles are given.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
