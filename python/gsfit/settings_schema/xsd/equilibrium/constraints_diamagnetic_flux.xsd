<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for constraints_diamagnetic_flux.xml: how the diamagnetic flux is fitted.

    Named as in the IMAS Data Dictionary: equilibrium time_slice[:]/constraints/diamagnetic_flux. As
    there, it is a single constraint, not an array, and it has no `name`: GSFit fits a single
    diamagnetic flux measurement, so the signals of several diamagnetic loops are averaged into one
    before they are supplied.
    The root element is `constraints__diamagnetic_flux`, the path of this file's link in
    equilibrium.xml with `__` for `/`, and the `diamagnetic_flux` element has the type
    `DiamagneticFlux`. Neither these names nor the Python classes generated from them then clash with
    those of the other constraints files.

    constraints_flux_loop.xsd, constraints_rogowski_coil.xsd, constraints_diamagnetic_flux.xsd and
    constraints_isoflux.xsd are the same apart from their names, documentation, units and number of
    elements, and the diamagnetic flux having no `name`, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= The settings file ================================= -->

    <xs:element name="constraints__diamagnetic_flux">
        <xs:annotation>
            <xs:documentation>
                Fitting settings for the diamagnetic flux, the toroidal flux from the plasma, with at most one `diamagnetic_flux` element.
                GSFit fits a single diamagnetic flux measurement, `magnetics/diamagnetic_flux(0)`, as the IMAS equilibrium IDS has a single constraint for it, `time_slice(itime)/constraints/diamagnetic_flux`.
                A machine with several diamagnetic loops must average their signals into one, in the `database_reader`, before supplying it.
                Without a `diamagnetic_flux` element, the diamagnetic flux is not copied from the magnetics IDS, and is not included in the fit.
                With one, the magnetics IDS must hold the diamagnetic flux.
                Only read by the st40_mdsplus and st40_mdsplus_with_digital_filter readers.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="diamagnetic_flux" type="DiamagneticFlux" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Fitting settings for the diamagnetic flux.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FiniteNonNegativeDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than or equal to 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TrueOrFalse">
        <xs:annotation>
            <xs:documentation>
                A boolean written as `true` or `false`; `xs:boolean` alone would also accept `1` and `0`.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:boolean">
            <xs:pattern value="true|false"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="DiamagneticFlux">
        <xs:annotation>
            <xs:documentation>
                Fitting settings for the diamagnetic flux.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="expected_value" type="FiniteDouble">
                <xs:annotation>
                    <xs:documentation>
                        Expected magnitude of the measurement, used to normalise the measurement.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>weber</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="weight" type="FiniteNonNegativeDouble">
                <xs:annotation>
                    <xs:documentation>
                        Relative weight of the diamagnetic flux in the least-squares fit.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="TrueOrFalse">
                <xs:annotation>
                    <xs:documentation>
                        Whether to include the diamagnetic flux in the fit.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="comment" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Free-text comment, e.g. on the quality of the signal; may be empty.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>
</xs:schema>
