<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for constraints_diamagnetic_flux.xml: how the diamagnetic loop is fitted.

    Named as in the IMAS Data Dictionary: equilibrium time_slice[:]/constraints/diamagnetic_flux. As
    there, it is a single constraint, not an array.
    The root element is `constraints__diamagnetic_flux`, the path of this file's link in
    equilibrium.xml with `__` for `/`, and the `diamagnetic_flux` element has the type
    `diamagnetic_flux`. Neither these names nor the Python classes generated from them then clash with
    those of the other constraints files.

    constraints_flux_loop.xsd, constraints_rogowski_coil.xsd, constraints_diamagnetic_flux.xsd and
    constraints_isoflux.xsd are the same apart from their names, documentation, units and number of
    elements, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= The settings file ================================= -->

    <xs:element name="constraints__diamagnetic_flux">
        <xs:annotation><xs:documentation>How the diamagnetic loop is fitted: a `diamagnetic_flux` named DIALOOP, or none. With none it is not fitted. Only read by the st40_mdsplus and st40_mdsplus_with_digital_filter readers</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="diamagnetic_flux" type="diamagnetic_flux" minOccurs="0">
                    <xs:annotation><xs:documentation>The diamagnetic loop, which measures the toroidal flux from the plasma</xs:documentation></xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="Name">
        <xs:annotation><xs:documentation>A name, with no spaces</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NonNegativeDouble">
        <xs:annotation><xs:documentation>A number greater than or equal to 0</xs:documentation></xs:annotation>
        <xs:restriction base="xs:double">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="diamagnetic_flux">
        <xs:annotation><xs:documentation>The diamagnetic loop, which measures the toroidal flux from the plasma</xs:documentation></xs:annotation>
        <xs:all>
            <xs:element name="name" type="Name">
                <xs:annotation><xs:documentation>The loop's name, which the readers expect to be "DIALOOP"</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="expected_value" type="xs:double">
                <xs:annotation>
                    <xs:documentation>The typical size of the loop's measured diamagnetic flux. The fit divides the residual by it</xs:documentation>
                    <xs:appinfo>
                        <units>Wb</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="weight" type="NonNegativeDouble">
                <xs:annotation>
                    <xs:documentation>Relative weight of the constraint in the fit. Its least-squares weight is weight / expected_value</xs:documentation>
                    <xs:appinfo>
                        <units>1</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="xs:boolean">
                <xs:annotation><xs:documentation>Whether the constraint is fitted</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="comment" type="xs:string">
                <xs:annotation><xs:documentation>Free text, e.g. why the constraint is not included; not used by the fit</xs:documentation></xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>
</xs:schema>
