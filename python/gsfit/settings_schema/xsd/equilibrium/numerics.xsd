<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for numerics.xml: the settings of the Grad-Shafranov solve, the number of threads it runs on, and how the Green's functions
    treat the conductors: as filaments, or with their finite size.

    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ===================================== Enums ===================================== -->

    <xs:simpleType name="NonlinearSolverMethod">
        <xs:annotation>
            <xs:documentation>
                The nonlinear solvers for the Grad-Shafranov equation.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="picard">
                <xs:annotation>
                    <xs:documentation>
                        Picard iterations, optionally with Anderson mixing.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="newton_krylov">
                <xs:annotation>
                    <xs:documentation>
                        Jacobian-free Newton-Krylov.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="newton_picard">
                <xs:annotation>
                    <xs:documentation>
                        Newton-Picard, the recursive projection method (RPM): Newton's method in the few directions in which Picard converges slowly or diverges, and Picard everywhere else.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ConductorModel">
        <xs:annotation>
            <xs:documentation>
                How the Green's functions treat every conductor: the plasma's grid cells, the PF coils' elements and the passive conductors' elements.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="point">
                <xs:annotation>
                    <xs:documentation>
                        Each conductor is a point in the (R, Z) plane, a filament at its centroid. A point on a conductor's centroid sees the conductor's own field from closed-form expressions for a rectangle.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="finite_size">
                <xs:annotation>
                    <xs:documentation>
                        A uniform current density over each conductor's parallelogram cross-section, from analytic series, with the accuracy set by `finite_size`.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="FiniteDouble">
        <xs:annotation>
            <xs:documentation>
                A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed, and nor is a number beyond the largest double, e.g. `1e400`, which would be read as infinite.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
            <xs:minInclusive value="-1.7976931348623157e308"/>
            <xs:maxInclusive value="1.7976931348623157e308"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FinitePositiveDouble">
        <xs:annotation>
            <xs:documentation>
                A finite number greater than 0.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PositiveFraction">
        <xs:annotation>
            <xs:documentation>
                A number greater than 0 and at most 1.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="FiniteDouble">
            <xs:minExclusive value="0.0"/>
            <xs:maxInclusive value="1.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TrueOrFalse">
        <xs:annotation>
            <xs:documentation>
                A boolean written as `true` or `false`; `xs:boolean` alone would also accept `1` and `0`.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:boolean">
            <xs:pattern value="true|false"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="numerics">
        <xs:annotation>
            <xs:documentation>
                Settings for the Grad-Shafranov solve, the number of threads it runs on, and the flux from, and the mutual inductance between, conductors of finite size.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="RAYON_NUM_THREADS" type="xs:nonNegativeInteger">
                    <xs:annotation>
                        <xs:documentation>
                            Number of threads for the Rust code. Sets the RAYON_NUM_THREADS environment variable, read by Rayon, Rust's parallelisation library; 0 lets Rayon choose one per CPU.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="n_iter_max" type="xs:positiveInteger">
                    <xs:annotation>
                        <xs:documentation>
                            Maximum number of nonlinear solver iterations; a time-slice which has not converged by then is marked as failed.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="grad_shafranov_deviation_tolerance" type="FinitePositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            The solve has converged once the Grad-Shafranov deviation, |psi_a - psi_a_previous| / |psi_b - psi_a| (EFIT's `cerror`), is below this.
                        </xs:documentation>
                        <xs:appinfo>
                            <units>dimensionless</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="n_iter_min" type="xs:nonNegativeInteger">
                    <xs:annotation>
                        <xs:documentation>
                            Minimum number of nonlinear solver iterations before the convergence test may pass.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="nonlinear_solver">
                    <xs:annotation>
                        <xs:documentation>
                            The nonlinear solver for the Grad-Shafranov equation.
                        </xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="method" type="NonlinearSolverMethod">
                                <xs:annotation>
                                    <xs:documentation>
                                        The nonlinear solver to use.
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="picard">
                                <xs:annotation>
                                    <xs:documentation>
                                        Settings for the Picard nonlinear solver.
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="n_iter_no_vertical_feedback" type="xs:nonNegativeInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Number of initial iterations with the vertical feedback (the fit of delta_z) switched off.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="apply_anderson_mixing" type="TrueOrFalse">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Whether to use Anderson mixing: each new state is the combination of the last few iterates which best cancels their residuals.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="anderson_n_history" type="xs:nonNegativeInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Maximum number of previous iterations Anderson mixing combines.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="anderson_mixing" type="PositiveFraction">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Fraction of the (Anderson-mixed) residual taken at each iteration; 1 for all of it.
                                                </xs:documentation>
                                                <xs:appinfo>
                                                    <units>dimensionless</units>
                                                </xs:appinfo>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="newton_krylov">
                                <xs:annotation>
                                    <xs:documentation>
                                        Settings for Jacobian-free Newton-Krylov nonlinear solver.
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="n_iter_no_vertical_feedback" type="xs:nonNegativeInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Number of initial iterations with the vertical feedback (the fit of delta_z) switched off, which are Picard iterations, before the hand over to Newton.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="picard_handover" type="FinitePositiveDouble">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Grad-Shafranov deviation below which it hands over from Picard to Newton iterations.
                                                </xs:documentation>
                                                <xs:appinfo>
                                                    <units>dimensionless</units>
                                                </xs:appinfo>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="n_krylov_max" type="xs:positiveInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Maximum number of Krylov directions per Newton iteration; each costs one Picard iteration's work.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="krylov_tolerance" type="FinitePositiveDouble">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    The Krylov solve stops once the linearised residual is this fraction of the residual.
                                                </xs:documentation>
                                                <xs:appinfo>
                                                    <units>dimensionless</units>
                                                </xs:appinfo>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="finite_difference_step" type="FinitePositiveDouble">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Step of the finite-difference Jacobian-vector products, as a multiple of the size of the residual.
                                                </xs:documentation>
                                                <xs:appinfo>
                                                    <units>dimensionless</units>
                                                </xs:appinfo>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="verbose" type="TrueOrFalse">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Whether to print the progress of each Newton iteration.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="newton_picard">
                                <xs:annotation>
                                    <xs:documentation>
                                        Settings for the Newton-Picard nonlinear solver, the recursive projection method (RPM).
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="n_basis_max" type="xs:nonNegativeInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Maximum number of directions in which Newton's method is used; each costs one Picard iteration's work to add.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="contraction_threshold" type="FinitePositiveDouble">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    A direction is added when the residual outside them shrinks by less than this factor per iteration.
                                                </xs:documentation>
                                                <xs:appinfo>
                                                    <units>dimensionless</units>
                                                </xs:appinfo>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="finite_difference_step" type="FinitePositiveDouble">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Step of the finite-difference Jacobian-vector products, as a multiple of the size of the residual.
                                                </xs:documentation>
                                                <xs:appinfo>
                                                    <units>dimensionless</units>
                                                </xs:appinfo>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="verbose" type="TrueOrFalse">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Whether to print the progress of each Newton-Picard iteration.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
                <xs:element name="greens">
                    <xs:annotation>
                        <xs:documentation>
                            How the Green's functions treat the conductors, and the accuracy of the finite-size calculation. This setting affects every conductor: the plasma's grid cells, the PF coils, and the passive conductors. Both for the flux produced by a conductor at a point, and the self- and mutual inductances.
                        </xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="conductor_model" type="ConductorModel">
                                <xs:annotation>
                                    <xs:documentation>
                                        How each conductor is modelled.
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="finite_size">
                                <xs:annotation>
                                    <xs:documentation>
                                        The flux from, its derivatives, and the mutual inductance between, conductors of finite size: parallelograms which carry a uniform current density, calculated from analytic series. Read whatever `conductor_model` is.
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="n_elliptic" type="xs:nonNegativeInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Near-field series: the highest power of 1 - k^2 kept in the series of the elliptic integrals. 0 is valid: it keeps only the first term, which is the GSFit paper's first approximation.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="n_thin_ring" type="xs:nonNegativeInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Near-field series: the highest order kept in the expansion about the thin ring. 0 is valid: it is the thin ring itself, which is the GSFit paper's second approximation; with n_elliptic = 0 as well, the near-field series is the paper's formula. A low order needs a loose relative_tolerance: with 0 and 1.0e-9, a point inside a conductor, or a self-inductance, cannot be calculated within n_subdivision_max halvings.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="n_multipole" type="xs:nonNegativeInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Far-field series: the highest order of the multipole expansion; 0 is a point filament.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="relative_tolerance" type="PositiveFraction">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    The relative accuracy wanted, which sets how small each series' expansion parameter has to be before the series is used.
                                                </xs:documentation>
                                                <xs:appinfo>
                                                    <units>dimensionless</units>
                                                </xs:appinfo>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="n_subdivision_max" type="xs:nonNegativeInteger">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    How many times a conductor may be halved, which is exact, until one of the two series converges fast enough. 0 is valid: a conductor is never halved, and it is an error if neither series converges fast enough for it.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
