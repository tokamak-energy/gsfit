<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="constraints__b_field_pol_probe">
        <xs:annotation>
            <xs:documentation>
                Fitting settings for the poloidal magnetic field probes (Mirnov coils), with one `b_field_pol_probe` element per probe.
                A probe read by the `database_reader` which is not listed here is not included in the fit.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="b_field_pol_probe" type="b_field_pol_probe" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>Fitting settings for one probe.</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
        <xs:key name="b_field_pol_probe_name_key">
            <xs:annotation>
                <xs:documentation>Each probe's `name` must be unique.</xs:documentation>
            </xs:annotation>
            <xs:selector xpath="b_field_pol_probe"/>
            <xs:field xpath="name"/>
        </xs:key>
    </xs:element>

    <xs:complexType name="b_field_pol_probe">
        <xs:sequence>
            <xs:element name="name" type="sensor_name">
                <xs:annotation>
                    <xs:documentation>
                        Name of the probe, e.g. `P101`.
                        Must be unique, and match the name read by the `database_reader`.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="comment" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Free-text comment, e.g. on the quality of the signal; may be empty.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="expected_value" type="finite_double_positive">
                <xs:annotation>
                    <xs:documentation>
                        Expected magnitude of the measurement, used for normalisation.
                        In the fit the probe is weighted by `weight / expected_value`.
                    </xs:documentation>
                    <xs:appinfo>
                        <units>tesla</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="true_or_false">
                <xs:annotation>
                    <xs:documentation>Whether to include the probe in the fit.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="weight" type="finite_double_non_negative">
                <xs:annotation>
                    <xs:documentation>Relative weight of the probe in the fit.</xs:documentation>
                    <xs:appinfo>
                        <units>dimensionless</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="finite_double">
        <xs:annotation>
            <xs:documentation>A finite `xs:double`; `NaN`, `INF` and `-INF` are not allowed.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+\-]?[0-9]+)?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="finite_double_non_negative">
        <xs:restriction base="finite_double">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="finite_double_positive">
        <xs:restriction base="finite_double">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="sensor_name">
        <xs:annotation>
            <xs:documentation>A non-empty name without any whitespace.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="true_or_false">
        <xs:annotation>
            <xs:documentation>A boolean written as `true` or `false`; `xs:boolean` alone would also accept `1` and `0`.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:boolean">
            <xs:pattern value="true|false"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
