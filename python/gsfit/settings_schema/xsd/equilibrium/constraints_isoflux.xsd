<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for constraints_isoflux.xml: the isoflux constraints.

    The IMAS Data Dictionary has no isoflux constraint, so this keeps GSFit's name.
    The root element is `constraints__isoflux`, the path of this file's link in equilibrium.xml
    with `__` for `/`, and each `isoflux` element has the type `isoflux`. Neither these names nor the
    Python classes generated from them then clash with those of the other constraints files.

    constraints_flux_loop.xsd, constraints_rogowski_coil.xsd, constraints_diamagnetic_flux.xsd and
    constraints_isoflux.xsd are the same apart from their names, documentation, units and number of
    elements, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= The settings file ================================= -->

    <xs:element name="constraints__isoflux">
        <xs:annotation>
            <xs:documentation>
                The isoflux constraints, which make pairs of points lie on the same flux surface, one `isoflux` per pair. Not read at present, and no database reader has a setting for where to read the points from, so listing any adds no constraints. Keep it empty
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="isoflux" type="isoflux" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>
                            One isoflux constraint
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
        <xs:unique name="constraints_isoflux_unique_name">
            <xs:annotation>
                <xs:documentation>
                    Each isoflux is listed at most once
                </xs:documentation>
            </xs:annotation>
            <xs:selector xpath="isoflux"/>
            <xs:field xpath="name"/>
        </xs:unique>
    </xs:element>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="Name">
        <xs:annotation>
            <xs:documentation>
                A name, with no spaces
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NonNegativeDouble">
        <xs:annotation>
            <xs:documentation>
                A number greater than or equal to 0
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:minInclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="isoflux">
        <xs:annotation>
            <xs:documentation>
                One isoflux constraint
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="name" type="Name">
                <xs:annotation>
                    <xs:documentation>
                        The constraint's name
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="expected_value" type="xs:double">
                <xs:annotation>
                    <xs:documentation>
                        The typical size of the flux difference between the two points. The fit divides the residual by it
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="weight" type="NonNegativeDouble">
                <xs:annotation>
                    <xs:documentation>
                        Relative weight of the constraint in the fit. Its least-squares weight is weight / expected_value
                    </xs:documentation>
                    <xs:appinfo>
                        <units>1</units>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Whether the constraint is fitted
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="comment" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Free text, e.g. why the constraint is not included; not used by the fit
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>
</xs:schema>
