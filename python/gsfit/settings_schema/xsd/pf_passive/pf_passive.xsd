<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for pf_passive.xml: how the database reader builds the pf_passive IDS, the geometry and resistivity of the passive structures.

    The root element is `pf_passive_settings`, the IDS's name followed by `_settings`.
    `workflow` links to workflow.xml, the central list of the MDSplus trees which the database reader reads from, and which run of each.
    The st40_mdsplus_with_digital_filter reader reads the passive structures from its ELMAG. The st40_astra_mdsplus
    reader reads the passive structures from fires.dat, in python/gsfit/database_readers/st40_astra_mdsplus/,
    and the freegs and freegsnke readers take them from what is passed to `Gsfit.run`.
    XmlPath and Link are the same in each IDS's schema, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Link to workflow.xml ================================= -->

    <xs:simpleType name="XmlPath">
        <xs:annotation>
            <xs:documentation>
                Path of an XML file, relative to the file holding the link
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:anyURI">
            <xs:pattern value="\S+\.xml"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Link">
        <xs:annotation>
            <xs:documentation>
                A link to the file holding these settings
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="href" type="XmlPath" use="required">
            <xs:annotation>
                <xs:documentation>
                    Path of the linked file, relative to the file holding the link, e.g. "../workflow.xml"
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="pf_passive_settings">
        <xs:annotation>
            <xs:documentation>
                How the database reader builds the pf_passive IDS: the geometry and resistivity of the passive structures. The st40_mdsplus_with_digital_filter reader reads its run from the workflow.xml linked in `workflow`
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="workflow" type="Link" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            A link to workflow.xml, the central list of the MDSplus trees which the database reader reads from, and which run of each, e.g. href="../workflow.xml". The st40_mdsplus_with_digital_filter reader reads the passive structures' geometry and resistivity from its ELMAG tree, VESSEL
                        </xs:documentation>
                        <xs:appinfo>
                            <schema>../workflow.xsd</schema>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
