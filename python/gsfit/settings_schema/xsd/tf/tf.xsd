<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for tf.xml: how the database reader builds the tf IDS, the toroidal field, `gsfit_rs.Tf`.

    The root element is `tf_settings`, the IDS's name followed by `_settings`.
    The reference radius is needed by every reader.
    `workflow` links to workflow.xml, the central list of the MDSplus trees which the database reader reads from, and which run of each.
    The st40_mdsplus_with_digital_filter reader reads the TF rod's current from its PSU2COIL. The freegs and freegsnke readers take
    the toroidal field from what is passed to `Gsfit.run`.
    XmlPath and Link are the same in each IDS's schema, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Link to workflow.xml ================================= -->

    <xs:simpleType name="XmlPath">
        <xs:annotation>
            <xs:documentation>
                Path of an XML file, relative to the file holding the link
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:anyURI">
            <xs:pattern value="\S+\.xml"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Link">
        <xs:annotation>
            <xs:documentation>
                A link to the file holding these settings
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="href" type="XmlPath" use="required">
            <xs:annotation>
                <xs:documentation>
                    Path of the linked file, relative to the file holding the link, e.g. "../workflow.xml"
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="PositiveDouble">
        <xs:annotation>
            <xs:documentation>
                A number greater than 0
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:double">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="tf_settings">
        <xs:annotation>
            <xs:documentation>
                How the database reader builds the tf IDS: the toroidal field. The st40_mdsplus_with_digital_filter reader reads its run from the workflow.xml linked in `workflow`
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="vacuum_toroidal_field_reference_radius" type="PositiveDouble">
                    <xs:annotation>
                        <xs:documentation>
                            Reference major radius at which the vacuum toroidal field is quoted, for every reader. Sets `tf/r0`, which is copied to equilibrium/vacuum_toroidal_field/r0. Must be greater than 0, which `Tf::set_r0` checks too
                        </xs:documentation>
                        <xs:appinfo>
                            <units>m</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="workflow" type="Link" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            A link to workflow.xml, the central list of the MDSplus trees which the database reader reads from, and which run of each, e.g. href="../workflow.xml". The st40_mdsplus_with_digital_filter reader reads the current in the TF rod from its PSU2COIL tree, TF.I_ROD
                        </xs:documentation>
                        <xs:appinfo>
                            <schema>../workflow.xsd</schema>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
