<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for tf.xml: how the database reader builds the tf IDS, the toroidal field, `gsfit_rs.Tf`.

    The root element is `tf_settings`, the IDS's name followed by `_settings`.
    The reference radius is needed by every reader.
    `workflow` links to workflow.xml, the central list of the codes which the database reader reads from, and which run of each.
    The st40_mdsplus_with_digital_filter reader reads the TF rod's current from its PSU2COIL.
    The other readers still have one optional element each, named after the reader. The reader picked by `method` in
    database_reader.xml reads only its own element, which must then be present. The freegs and freegsnke readers take
    the toroidal field from what is passed to `Gsfit.run`, so have no element.
    XmlPath, Link, WorkflowEntry and MockWorkflowEntry are the same in each IDS's schema, as is WorkflowEntry in
    workflow.xsd, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Link to workflow.xml ================================= -->

    <xs:simpleType name="XmlPath">
        <xs:annotation><xs:documentation>Path of an XML file, relative to the file holding the link</xs:documentation></xs:annotation>
        <xs:restriction base="xs:anyURI">
            <xs:pattern value="\S+\.xml"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Link">
        <xs:annotation><xs:documentation>A link to the file holding these settings</xs:documentation></xs:annotation>
        <xs:attribute name="href" type="XmlPath" use="required">
            <xs:annotation><xs:documentation>Path of the linked file, relative to the file holding the link, e.g. "../workflow.xml"</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- ================================= Other simple types ================================= -->

    <xs:simpleType name="PositiveDouble">
        <xs:annotation><xs:documentation>A number greater than 0</xs:documentation></xs:annotation>
        <xs:restriction base="xs:double">
            <xs:minExclusive value="0.0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ================================= Complex types ================================= -->

    <xs:complexType name="WorkflowEntry">
        <xs:annotation><xs:documentation>Which run of an MDSplus tree to read. The tree is named by the element holding this, e.g. `elmag` for ELMAG</xs:documentation></xs:annotation>
        <xs:all>
            <xs:element name="pulseNo" type="xs:int" nillable="true">
                <xs:annotation><xs:documentation>The pulse to read the tree from; nil for the pulse being reconstructed</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="run_name" type="xs:string">
                <xs:annotation><xs:documentation>The run of the tree to read, e.g. "BEST" or "RUN16"</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="usage" type="xs:string">
                <xs:annotation><xs:documentation>What the tree's data is used for. Free text, which the Tokamak Energy writers store with the results (INPUT.WORKFLOW.[tree].USAGE), to record where the inputs came from</xs:documentation></xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="MockWorkflowEntry">
        <xs:annotation><xs:documentation>Which mocked MDSplus tree, pulse and run to read. The read is named by the element holding this, e.g. `elmag`. Reads are named separately from trees, so that one tree can be read more than once, e.g. from a different pulse</xs:documentation></xs:annotation>
        <xs:all>
            <xs:element name="tree_name" type="xs:string">
                <xs:annotation><xs:documentation>The mocked MDSplus tree, e.g. "ELMAG" or "MAG". Its data is read from `mdsplus_mock_[tree_name]_[pulseNo].npz` in `mock_dir`, in database_reader.xml, with the tree name in lower case</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="pulseNo" type="xs:int" nillable="true">
                <xs:annotation><xs:documentation>The pulse to read the tree from; nil for the pulse being reconstructed</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="run_name" type="xs:string">
                <xs:annotation><xs:documentation>The run to read, which must be the run the mock was captured from, e.g. "BEST" or "RUN16"</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="usage" type="xs:string">
                <xs:annotation><xs:documentation>What the tree's data is used for. Free text, which the Tokamak Energy writers store with the results (INPUT.WORKFLOW.[tree].USAGE), to record where the inputs came from</xs:documentation></xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="TfSt40Mdsplus">
        <xs:annotation><xs:documentation>Where the st40_mdsplus reader reads the toroidal field from</xs:documentation></xs:annotation>
        <xs:all>
            <xs:element name="psu2coil" type="WorkflowEntry">
                <xs:annotation><xs:documentation>The PSU2COIL run holding the current in the TF rod, TF.I_ROD</xs:documentation></xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="TfSt40AstraMdsplus">
        <xs:annotation><xs:documentation>Where the st40_astra_mdsplus reader reads the toroidal field from</xs:documentation></xs:annotation>
        <xs:all>
            <xs:element name="astra" type="WorkflowEntry">
                <xs:annotation><xs:documentation>The ASTRA run holding the vacuum toroidal field, GLOBAL:BTVAC</xs:documentation></xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="TfSt40SpiderMdsplus">
        <xs:annotation><xs:documentation>Where the st40_spider_mdsplus reader reads the toroidal field from</xs:documentation></xs:annotation>
        <xs:all>
            <xs:element name="spider" type="WorkflowEntry">
                <xs:annotation><xs:documentation>The SPIDER run holding the vacuum toroidal field and the radius it is quoted at, GLOBAL:BTVAC_GEO and GLOBAL:RGEO</xs:documentation></xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="TfMockSt40Mdsplus">
        <xs:annotation><xs:documentation>Where the mock_st40_mdsplus reader reads the toroidal field from</xs:documentation></xs:annotation>
        <xs:all>
            <xs:element name="psu2coil" type="MockWorkflowEntry">
                <xs:annotation><xs:documentation>The mocked PSU2COIL tree holding the current in the TF rod</xs:documentation></xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="tf_settings">
        <xs:annotation><xs:documentation>How the database reader builds the tf IDS: the toroidal field. The st40_mdsplus_with_digital_filter reader reads its run from the workflow.xml linked in `workflow`; the other readers read only the element named after them</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="vacuum_toroidal_field_reference_radius" type="PositiveDouble">
                    <xs:annotation>
                        <xs:documentation>Reference major radius at which the vacuum toroidal field is quoted, for every reader. Sets `tf/r0`, which is copied to equilibrium/vacuum_toroidal_field/r0. Must be greater than 0, which `Tf::set_r0` checks too</xs:documentation>
                        <xs:appinfo>
                            <units>m</units>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="workflow" type="Link" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>A link to workflow.xml, the central list of the codes which the database reader reads from, and which run of each, e.g. href="../workflow.xml". The st40_mdsplus_with_digital_filter reader reads the current in the TF rod from its `psu2coil`, TF.I_ROD</xs:documentation>
                        <xs:appinfo>
                            <schema>../workflow.xsd</schema>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
                <xs:element name="st40_mdsplus" type="TfSt40Mdsplus" minOccurs="0">
                    <xs:annotation><xs:documentation>Where the st40_mdsplus reader reads the toroidal field from</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="st40_astra_mdsplus" type="TfSt40AstraMdsplus" minOccurs="0">
                    <xs:annotation><xs:documentation>Where the st40_astra_mdsplus reader reads the toroidal field from</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="st40_spider_mdsplus" type="TfSt40SpiderMdsplus" minOccurs="0">
                    <xs:annotation><xs:documentation>Where the st40_spider_mdsplus reader reads the toroidal field from</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="mock_st40_mdsplus" type="TfMockSt40Mdsplus" minOccurs="0">
                    <xs:annotation><xs:documentation>Where the mock_st40_mdsplus reader reads the toroidal field from</xs:documentation></xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
