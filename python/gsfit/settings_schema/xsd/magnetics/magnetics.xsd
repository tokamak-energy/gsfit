<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for magnetics.xml: how the database reader builds the magnetics IDS, the geometry and measurements of the magnetic sensors.

    The root element is `magnetics_settings`, the IDS's name followed by `_settings`.
    `workflow` links to workflow.xml, the central list of the MDSplus trees which the database reader reads from, and which run of each.
    The st40_mdsplus_with_digital_filter reader reads the magnetic sensors from its MAG, and the diamagnetic flux from its DIALOOP.
    The freegs and freegsnke readers take the magnetic sensors from what is passed to `Gsfit.run`.
    XmlPath and Link are the same in each IDS's schema, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Link to workflow.xml ================================= -->

    <xs:simpleType name="XmlPath">
        <xs:annotation>
            <xs:documentation>
                Path of an XML file, relative to the file holding the link.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:anyURI">
            <xs:pattern value="\S+\.xml"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Link">
        <xs:annotation>
            <xs:documentation>
                A link to the file holding these settings.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="href" type="XmlPath" use="required">
            <xs:annotation>
                <xs:documentation>
                    Path of the linked file, relative to the file holding the link, e.g. "../workflow.xml".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="magnetics_settings">
        <xs:annotation>
            <xs:documentation>
                How the database reader builds the magnetics IDS: the geometry and measurements of the magnetic sensors. The st40_mdsplus_with_digital_filter reader reads its runs from the workflow.xml linked in `workflow`.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="workflow" type="Link" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            A link to workflow.xml, the central list of the MDSplus trees which the database reader reads from, and which run of each, e.g. href="../workflow.xml". The st40_mdsplus_with_digital_filter reader reads the poloidal field probes, flux loops and Rogowski coils, and the diamagnetic loop's geometry, from its MAG tree, and the diamagnetic flux from its DIALOOP tree, GLOBAL.PHI_DIA.
                        </xs:documentation>
                        <xs:appinfo>
                            <schema>../workflow.xsd</schema>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
