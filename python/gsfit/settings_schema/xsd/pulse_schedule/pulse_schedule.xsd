<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema for pulse_schedule.xml: how the database reader builds the pulse_schedule IDS, the gaps between the plasma boundary and the wall.

    The root element is `pulse_schedule_settings`, the IDS's name followed by `_settings`.
    `workflow` links to workflow.xml, the central list of the MDSplus trees which the database reader reads from, and which run of each.
    Only the st40_mdsplus_with_digital_filter reader builds a pulse_schedule, from its ELMAG; without one, the equilibrium has no gaps.
    XmlPath and Link are the same in each IDS's schema, so change them all together.
    See ../GSFIT_code_settings.xsd for the conventions shared by all the schemas.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- ================================= Link to workflow.xml ================================= -->

    <xs:simpleType name="XmlPath">
        <xs:annotation>
            <xs:documentation>
                Path of an XML file, relative to the file holding the link
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:anyURI">
            <xs:pattern value="\S+\.xml"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Link">
        <xs:annotation>
            <xs:documentation>
                A link to the file holding these settings
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="href" type="XmlPath" use="required">
            <xs:annotation>
                <xs:documentation>
                    Path of the linked file, relative to the file holding the link, e.g. "../workflow.xml"
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- ================================= The settings file ================================= -->

    <xs:element name="pulse_schedule_settings">
        <xs:annotation>
            <xs:documentation>
                How the database reader builds the pulse_schedule IDS: the gaps between the plasma boundary and the wall. Only the st40_mdsplus_with_digital_filter reader builds one, reading its run from the workflow.xml linked in `workflow`
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="workflow" type="Link" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            A link to workflow.xml, the central list of the MDSplus trees which the database reader reads from, and which run of each, e.g. href="../workflow.xml". The st40_mdsplus_with_digital_filter reader reads the gaps, their names, origins and angles, from its ELMAG tree, GAPS
                        </xs:documentation>
                        <xs:appinfo>
                            <schema>../workflow.xsd</schema>
                        </xs:appinfo>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
