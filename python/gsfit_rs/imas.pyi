    @property
    def midplane_thickness(self) -> Path[float]:
        """Thickness of this unit evaluated at the midplane (whenever relevant)

        Units: m
        """
    @property
    def midplane_power_density_nuclear(self) -> _WallSignalFlt1dItem:
        """Nuclear power density heating this unit evaluated at the midplane (whenever relevant)

        Units: W.m^-3
        """
    @property
    def power_nuclear(self) -> _WallSignalFlt1dItem:
        """Nuclear power heating this unit

        Units: W
        """

