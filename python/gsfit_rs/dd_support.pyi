class ParametersInput:
    """The code parameters block passed from the wrapper to the code.

    It holds the code parameters and their defaults, each as XML, and the XML schema they follow.
    Unlike an IDS, it is built in Python and handed to `gsfit_rs`, and cannot be changed once built.
    """

    def __init__(self, *, parameters_value: str = "", parameters_default: str = "", schema: str = "") -> None:
        """
        Every argument defaults to "", the IMAS value of an unset string.

        :param parameters_value: The code parameters, as XML
        :param parameters_default: The default code parameters, as XML
        :param schema: The XML schema of the code parameters
        """

    @property
    def parameters_value(self) -> str:
        """The code parameters, as XML."""

    @property
    def parameters_default(self) -> str:
        """The default code parameters, as XML."""

    @property
    def schema(self) -> str:
        """The XML schema of the code parameters."""
