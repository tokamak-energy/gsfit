                    <xs:documentation>
                        Source: each passive degree of freedom, in the order of `greens_tables/grid/pf_passive(:)/dof(:)`, at each time-slice.
                        Shape = `(n_time, n_dof_total)`
                    </xs:documentation>
                    <xs:appinfo>
                        <units>Wb.A^-1</units>
                    </xs:appinfo>
                </xs:annotation>
                <xs:complexType>
                    <xs:group ref="FLT_2D"/>
                </xs:complexType>
