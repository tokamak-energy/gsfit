            </xs:element>
            <xs:element name="pf_passive">
                <xs:annotation>
                    <xs:documentation>
                        Source: each passive degree of freedom, in the order of `greens_tables/grid/pf_passive(:)/dof(:)`
                    </xs:documentation>
                    <xs:appinfo>
                        <units>T.A^-1</units>
