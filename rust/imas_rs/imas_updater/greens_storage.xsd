                        Source: each PF coil, in the order of `greens_tables/grid/pf_active`
                    </xs:documentation>
                    <xs:appinfo>
                        <units>T.A^-1</units>
                    </xs:appinfo>
                </xs:annotation>
                <xs:complexType>
